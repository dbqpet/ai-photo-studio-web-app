# Google Gemini — Nano Banana Pro image generation (required)
GEMINI_API_KEY=
# Validation model (default: gemini-flash-latest)
GEMINI_MODEL=
# Nano Banana Pro image model (default: gemini-3-pro-image)
GEMINI_IMAGE_MODEL=

# Stripe Checkout ($18 HKD). Leave blank to use mock checkout in local dev.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
