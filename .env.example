# Google Gemini — Nano Banana Pro image generation (required)
GEMINI_API_KEY=
# Validation model (default: gemini-flash-latest)
GEMINI_MODEL=
# Nano Banana Pro image model (default: gemini-3-pro-image)
GEMINI_IMAGE_MODEL=

# Supabase Auth (Google OAuth) + profiles/credits
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server-only (Stripe webhook credit grants). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout ($4.99 USD launch special). Leave blank to use mock checkout in local dev.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
